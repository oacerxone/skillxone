# Copy to .env (pnpm bootstrap does this for you). Never commit .env.

# Database. SQLite is the default; a relative path is resolved from the repository root.
#   SQLite:      file:./data/skillxone.db
#   PostgreSQL:  postgres://user:password@localhost:5432/skillxone
DATABASE_URL=file:./data/skillxone.db

# Public base URL of the site, used for canonical links.
SITE_URL=http://localhost:3000

# GitHub token for ingestion (Phase 3). Fine-grained token, public repositories, read-only.
# Leave empty until then. It is never logged or returned by any endpoint.
GITHUB_TOKEN=

# Optional User-Agent for GitHub requests. GitHub asks API clients to identify themselves;
# set this to your instance name or contact URL. A generic value is used when empty.
GITHUB_USER_AGENT=

# Worker limits.
WORKER_CONCURRENCY=4
SCAN_CONCURRENCY=1

# Security scanning (static only; nothing from a skill is executed).
# A scan that exceeds this many seconds is FAILED, never passed.
SCAN_TIMEOUT_SECONDS=60
# Days a verification stays valid before a rescan is required.
VERIFICATION_DAYS=30
# Look up dependency vulnerabilities in OSV.dev (1) or record the check as skipped (0).
OSV_LOOKUPS=1
# Optional absolute path to a gitleaks binary. When unset, PATH is searched; when absent, the
# optional gitleaks check is recorded as skipped.
GITLEAKS_PATH=

# Development fixtures are refused in production unless this is 1.
ALLOW_DEV_FIXTURES=0

# Public API: requests allowed per client per minute.
API_RATE_LIMIT_PER_MINUTE=120

# Set to 1 only when the app runs behind a reverse proxy you control that sets
# X-Forwarded-For. It makes rate limiting per client address instead of global.
TRUST_PROXY=0

# Schedules: minutes between runs (0 turns one off). `pnpm worker schedule` queues due work;
# `pnpm worker serve` runs schedules and jobs continuously. See docs/development/worker.md.
# SCHEDULE_TRENDING_MINUTES=360
# SCHEDULE_RECENT_MINUTES=1440
# SCHEDULE_FULL_MINUTES=10080
# SCHEDULE_RANKING_MINUTES=1440
# SCHEDULE_VERIFICATION_MINUTES=60
# SCHEDULE_MAINTENANCE_MINUTES=1440
