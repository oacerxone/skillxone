{
  "name": "skillxone",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, self-hostable marketplace for AI agent skills hosted on GitHub.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "node scripts/bootstrap.mjs && pnpm --filter @skillxone/web dev",
    "build": "pnpm --filter @skillxone/web build",
    "start": "pnpm --filter @skillxone/web start",
    "worker": "tsx apps/worker/src/cli.ts",
    "db:migrate": "pnpm worker migrate",
    "db:seed:dev": "pnpm worker seed --dev",
    "tokens": "tsx packages/ui/src/generate-css.ts",
    "bench:search": "tsx scripts/bench-search.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p . && pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "node scripts/bootstrap.mjs && pnpm build && playwright test",
    "export:static": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/export-static.ts",
    "test:static": "node scripts/bootstrap.mjs && pnpm export:static && playwright test -c playwright.static.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
